rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Un classement par circuit
    match /{col}/{id} {
      // Tout le monde peut lire les classements
      allow read: if col in ['scores', 'scores_ovale', 'scores_desert'];
      // On peut seulement AJOUTER un score, avec des valeurs plausibles
      allow create: if col in ['scores', 'scores_ovale', 'scores_desert']
        && request.resource.data.keys().hasOnly(['name', 'time', 'bestLap', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.time is int
        && request.resource.data.time > 30000
        && request.resource.data.time < 3600000
        && request.resource.data.bestLap is int
        && request.resource.data.bestLap * 3 <= request.resource.data.time + 3000
        && request.resource.data.createdAt == request.time;
      // Personne ne peut modifier ou supprimer les scores
      allow update, delete: if false;
    }
  }
}
